/* The ~ dev panel: small, in the HUD's colours, under the cash. Its list scrolls past a few rows. */

.dev-panel {
    position: absolute;
    left: 22px;
    top: 85px;
    width: 260px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(27, 23, 36, 0.92);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    color: rgb(241, 230, 208);
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/AlegreyaSans-Regular-Lining.ttf");
    font-size: 15px;
}

.dev-title {
    padding-left: 8px;
    padding-bottom: 4px;
    font-size: 13px;
    color: rgb(216, 207, 193);
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/Cinzel-Bold.ttf");
}

.dev-list {
    max-height: 240px;
}

.dev-row {
    height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.dev-row--selected {
    background-color: rgb(227, 184, 102);
    color: rgb(27, 23, 36);
}

.dev-row--unavailable {
    opacity: 0.45;
}
